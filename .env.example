# ==============================================================================
# ThreatLenz - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your local setup.
# ==============================================================================

# Application
APP_NAME=ThreatLenz
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threatlenz
POSTGRES_USER=threatlenz
POSTGRES_PASSWORD=change_me

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Data paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_EXTERNAL_DIR=data/external
DATA_SAMPLE_DIR=data/sample

# Spark
SPARK_APP_NAME=ThreatLenz
SPARK_MASTER=local[*]

# Model
MODEL_DIR=models
